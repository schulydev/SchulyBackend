# Public hostnames (point DNS at this server before starting).
API_HOST=api.staging.schuly.dev
AUTH_HOST=auth.staging.schuly.dev

# Image versions. `latest` follows every release; pin a version like 1.3.3 to
# decide for yourself when to move.
SCHULY_VERSION=latest
KEYCLOAK_VERSION=latest

# Postgres (used by the backend AND Keycloak).
POSTGRES_USER=schuly
POSTGRES_PASSWORD=change-me-postgres

# Keycloak bootstrap admin (https://${AUTH_HOST}, master realm).
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-kc-admin

# Optional. Confidential client in the `schuly` realm whose service account holds
# the realm-management `manage-users` role. Fill both in and deleting an account
# in the app also deletes the Keycloak user; leave them empty and the backend
# deletes only its own data and logs a warning.
KC_ADMIN_CLIENT_ID=
KC_ADMIN_CLIENT_SECRET=

# SeaweedFS S3 credentials - MUST match config/seaweedfs/s3-config.json.
S3_ACCESS_KEY=schuly-staging-access
S3_SECRET_KEY=change-me-s3-secret

# HMAC key for signing avatar URLs (any long random string).
# Generate one with: openssl rand -hex 32
AVATAR_SIGNING_KEY=change-me-avatar-signing-key

# Master key for encrypting student documents at rest (base64, 32 bytes).
# Generate one with: openssl rand -base64 32
# Losing or changing this key makes already-stored documents unreadable.
DOCUMENTS_ENCRYPTION_KEY=change-me-documents-encryption-key

# Master key for the plugin vault (base64, exactly 32 bytes). Encrypts the school
# credentials plugins store. Keep it stable - the backend cannot decrypt anything
# written under a different key. Generate one with: openssl rand -base64 32
VAULT_MASTER_KEY=change-me-vault-master-key

# Mail server for the Keycloak `schuly` realm. Optional - leave these commented
# out and the realm imports with no working mail (SMTP_FROM then defaults to
# noreply@${API_HOST}). Fill them in for verified emails and password reset.
# Applied on the FIRST start only, when the realm is imported; afterwards change
# mail settings in the Keycloak admin console under Realm settings → Email.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_FROM=noreply@schuly.example
#SMTP_USER=schuly
#SMTP_PASSWORD=change-me-smtp
#SMTP_SSL=false
#SMTP_STARTTLS=true

# Firebase service account for push notifications. Optional - base64 of the
# service-account JSON; leave unset to run without push.
#FIREBASE_SERVICE_ACCOUNT_JSON=
