# Backend application settings. `${...}` values are filled from .env.
# These are wiring, not operator knobs - the values you actually change per
# deployment (hostnames, secrets, image versions) live in .env.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080

ConnectionStrings__SchulyDatabase=Host=postgres;Port=5432;Database=schuly;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# Validate tokens against the Keycloak `schuly` realm. The issuer must match what
# the app logs in against, so use the public auth URL.
Oidc__Authority=https://${AUTH_HOST}/realms/schuly
Oidc__ClientId=schuly-app
Oidc__RequireHttpsMetadata=true

# The in-code default redirect URIs are the web (localhost:4200) callbacks. The
# mobile app uses the schulytest:// deep link, so advertise that here (already
# registered on the schuly-app Keycloak client).
Oidc__RedirectUri=schulytest://callback
Oidc__PostLogoutRedirectUri=schulytest://callback

# Service-account client the backend uses to delete the Keycloak user when someone
# deletes their account. Leave empty and the backend still deletes everything it
# stores, logs a warning, and leaves the Keycloak user for you to remove by hand.
Oidc__AdminClientId=${KC_ADMIN_CLIENT_ID}
Oidc__AdminClientSecret=${KC_ADMIN_CLIENT_SECRET}

Avatar__SigningKey=${AVATAR_SIGNING_KEY}

# Encrypts plugin vault entries (the school credentials plugins sync with) at
# rest. It must stay stable across deployments - change it and every stored
# credential becomes unreadable, forcing every user to reconnect their school.
Vault__MasterKey=${VAULT_MASTER_KEY}

# Document storage (SeaweedFS S3).
S3__Endpoint=http://seaweedfs:8333
S3__Bucket=schuly
S3__AccessKey=${S3_ACCESS_KEY}
S3__SecretKey=${S3_SECRET_KEY}
S3__UsePathStyle=true

# Documents are encrypted at rest with this key before they reach the bucket; losing it makes stored documents unreadable.
Documents__EncryptionKey=${DOCUMENTS_ENCRYPTION_KEY}

# Retention sweep: daily, first pass five minutes after startup. Cached school data
# is dropped for school users who left longer than MonthsAfterLeave ago, and whole
# accounts are dropped after MonthsInactive without a signed-in request.
Retention__Enabled=true
Retention__MonthsAfterLeave=6
Retention__MonthsInactive=12

# Plugins: declared in plugins.yml, downloaded + loaded on startup.
Plugins__Directory=/app/plugins
Plugins__ConfigDirectory=/app/plugins-config
Plugins__File=/app/plugins.yml

# Caddy terminates TLS and proxies from the compose network, so the real client
# IP arrives in X-Forwarded-For. Trust the private docker network range so rate
# limiting partitions on the caller, not on Caddy's container IP.
ForwardedHeaders__KnownNetworks__0=172.16.0.0/12
