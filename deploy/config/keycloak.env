# Keycloak settings. `${...}` values are filled from .env.
# The image is an optimized build with the `schuly` realm baked in.

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=${POSTGRES_USER}
KC_DB_PASSWORD=${POSTGRES_PASSWORD}
KC_HOSTNAME=https://${AUTH_HOST}
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_BOOTSTRAP_ADMIN_USERNAME=${KC_ADMIN_USER}
KC_BOOTSTRAP_ADMIN_PASSWORD=${KC_ADMIN_PASSWORD}

# Fills the realm's mail server on the first import only. Optional - leave the
# values unset in .env and the realm imports without a working mail server.
SMTP_HOST=${SMTP_HOST:-}
SMTP_PORT=${SMTP_PORT:-}
SMTP_FROM=${SMTP_FROM:-noreply@${API_HOST}}
SMTP_USER=${SMTP_USER:-}
SMTP_PASSWORD=${SMTP_PASSWORD:-}
SMTP_SSL=${SMTP_SSL:-}
SMTP_STARTTLS=${SMTP_STARTTLS:-}
