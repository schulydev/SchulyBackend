<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.40.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.7" />
    <!-- See Schuly.Application.csproj for why ExcludeAssets is needed. -->
    <PackageReference Include="Schuly.Plugin.Abstractions" Version="0.2.*"
                      GeneratePathProperty="true" ExcludeAssets="compile;runtime" />
    <Reference Include="Schuly.Plugin.Abstractions">
      <HintPath>$(PkgSchuly_Plugin_Abstractions)\lib\net10.0\Schuly.Plugin.Abstractions.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Schuly.Application/Schuly.Application.csproj" />
    <ProjectReference Include="../Schuly.Domain/Schuly.Domain.csproj" />
    <ProjectReference Include="../Schuly.Infrastructure/Schuly.Infrastructure.csproj" />
    <ProjectReference Include="../Schuly.API/Schuly.API.csproj" />
  </ItemGroup>

</Project>
