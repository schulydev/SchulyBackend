<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
    <!-- Schuly.Plugin.Abstractions bundles Schuly.Domain.dll + Schuly.Infrastructure.dll
         in lib/net10.0/ for the benefit of plugin authors. The backend has those
         types via ProjectReference already, so we must NOT take the bundled copies
         (CS1704 duplicate-assembly). ExcludeAssets="compile;runtime" drops the
         entire lib/ folder, and we add the one DLL we actually need back via an
         explicit Reference using the package's exposed path. -->
    <PackageReference Include="Schuly.Plugin.Abstractions" Version="0.2.*"
                      GeneratePathProperty="true" ExcludeAssets="compile;runtime" />
    <Reference Include="Schuly.Plugin.Abstractions">
      <HintPath>$(PkgSchuly_Plugin_Abstractions)\lib\net10.0\Schuly.Plugin.Abstractions.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Schuly.Domain\Schuly.Domain.csproj" />
    <ProjectReference Include="..\Schuly.Infrastructure\Schuly.Infrastructure.csproj" />
  </ItemGroup>

</Project>
